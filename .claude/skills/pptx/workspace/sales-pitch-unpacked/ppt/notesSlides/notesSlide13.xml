            </a:pPr>
            <a:r>
              <a:rPr lang="en"/>
              <a:t>Let me be direct: efficiency is table stakes. Of course AI should reduce costs. Of course it should handle volume. That's the most basic thing you could expect.</a:t>
            </a:r>
            <a:endParaRPr/>
          </a:p>
          <a:p>
            <a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l">
              <a:spcBef>
