            <a:r>
              <a:rPr lang="en"/>
              <a:t>Let me address pricing, because our model is different &#8212; and intentionally so.</a:t>
            </a:r>
            <a:endParaRPr/>
          </a:p>
          <a:p>
            <a:pPr indent="0" lvl="0" marL="0" rtl="0" algn="l">
